{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Gruvbox Dark palette for the curly-barnacle site. Import into Figma via the Variables panel or Tokens Studio.",
  "gruvbox": {
    "$type": "color",
    "$description": "Full Gruvbox Dark spectrum (canonical morhetz/gruvbox values)",
    "dark0_hard": { "$value": "#1d2021" },
    "dark0": { "$value": "#282828" },
    "dark0_soft": { "$value": "#32302f" },
    "dark1": { "$value": "#3c3836" },
    "dark2": { "$value": "#504945" },
    "dark3": { "$value": "#665c54" },
    "dark4": { "$value": "#7c6f64" },
    "gray": { "$value": "#928374" },
    "light0_hard": { "$value": "#f9f5d7" },
    "light0": { "$value": "#fbf1c7" },
    "light0_soft": { "$value": "#f2e5bc" },
    "light1": { "$value": "#ebdbb2" },
    "light2": { "$value": "#d5c4a1" },
    "light3": { "$value": "#bdae93" },
    "light4": { "$value": "#a89984" },
    "bright_red": { "$value": "#fb4934" },
    "bright_green": { "$value": "#b8bb26" },
    "bright_yellow": { "$value": "#fabd2f" },
    "bright_blue": { "$value": "#83a598" },
    "bright_purple": { "$value": "#d3869b" },
    "bright_aqua": { "$value": "#8ec07c" },
    "bright_orange": { "$value": "#fe8019" },
    "neutral_red": { "$value": "#cc241d" },
    "neutral_green": { "$value": "#98971a" },
    "neutral_yellow": { "$value": "#d79921" },
    "neutral_blue": { "$value": "#458588" },
    "neutral_purple": { "$value": "#b16286" },
    "neutral_aqua": { "$value": "#689d6a" },
    "neutral_orange": { "$value": "#d65d0e" },
    "faded_red": { "$value": "#9d0006" },
    "faded_green": { "$value": "#79740e" },
    "faded_yellow": { "$value": "#b57614" },
    "faded_blue": { "$value": "#076678" },
    "faded_purple": { "$value": "#8f3f71" },
    "faded_aqua": { "$value": "#427b58" },
    "faded_orange": { "$value": "#af3a03" }
  },
  "color": {
    "$type": "color",
    "$description": "Semantic tokens consumed by the site; aliases into the gruvbox group",
    "background": { "$value": "{gruvbox.dark0}" },
    "surface": { "$value": "{gruvbox.dark1}" },
    "text": { "$value": "{gruvbox.light1}" },
    "muted": { "$value": "{gruvbox.light4}" },
    "border": { "$value": "{gruvbox.dark2}" },
    "accent": { "$value": "{gruvbox.bright_green}" }
  }
}
